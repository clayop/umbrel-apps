# Status page, reached only through the umbrelOS app_proxy (Umbrel login applies).
server {
    listen 80;
    root /usr/share/nginx/html;

    location = /rpc {
        limit_except POST { deny all; }
        proxy_pass http://${ZEBRA_RPC_UPSTREAM}/;
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
    }
}

# JSON-RPC for LAN clients, protected by HTTP basic auth.
server {
    listen 8232;
    client_max_body_size 1m;

    location / {
        auth_basic "zebra";
        auth_basic_user_file /etc/nginx/conf.d/htpasswd;
        limit_except POST { deny all; }
        proxy_pass http://${ZEBRA_RPC_UPSTREAM}/;
        proxy_set_header Authorization "";
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
    }
}
